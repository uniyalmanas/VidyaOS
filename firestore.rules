rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------------
    // AUTHENTICATION & MULTI-TENANT RBAC HELPERS
    // ------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function hasUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return getUserDoc().role;
    }

    function getUserOrgId() {
      return getUserDoc().orgId;
    }

    // Role conveyed by the ID token's custom claim, if any. The claim is usually
    // absent (phone-auth users carry no role claim) and the rules runtime throws
    // when reading a property off a missing token — so presence is guarded here,
    // letting `isPlatformOwner()` etc. return a clean false instead of erroring.
    function tokenRole() {
      return (request.auth.token != null && 'role' in request.auth.token) ? request.auth.token.role : null;
    }

    function isPlatformOwner() {
      return isSignedIn() && (
        (tokenRole() == 'PLATFORM_OWNER') ||
        (hasUserDoc() && getUserRole() == 'PLATFORM_OWNER')
      );
    }

    function isCenterAdmin() {
      return isSignedIn() && (
        (tokenRole() == 'CENTER_ADMIN') ||
        (hasUserDoc() && getUserRole() == 'CENTER_ADMIN')
      );
    }

    function isStaff() {
      return isSignedIn() && (
        (tokenRole() == 'STAFF') ||
        (hasUserDoc() && getUserRole() == 'STAFF')
      );
    }

    function isTeacher() {
      return isSignedIn() && (
        (tokenRole() == 'TEACHER') ||
        (hasUserDoc() && getUserRole() == 'TEACHER')
      );
    }

    function isStudent() {
      return isSignedIn() && hasUserDoc() && getUserRole() == 'STUDENT';
    }

    function isParent() {
      return isSignedIn() && hasUserDoc() && getUserRole() == 'PARENT';
    }

    function ownsOrganization(orgId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/organizations/$(orgId)) &&
        get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerUid == request.auth.uid;
    }

    // Strict multi-tenant isolation helper (NO unprofiled bypass)
    function isTenantMember(orgId) {
      return isSignedIn() && orgId != null && (
        isPlatformOwner() ||
        (request.auth.token.orgId == orgId) ||
        (hasUserDoc() && getUserOrgId() == orgId)
      );
    }

    function isCenterStaffOrAdmin(orgId) {
      return isTenantMember(orgId) && (isPlatformOwner() || isCenterAdmin() || isStaff());
    }

    function isCenterInstructorOrAdmin(orgId) {
      return isTenantMember(orgId) && (isPlatformOwner() || isCenterAdmin() || isTeacher());
    }

    // ------------------------------------------------------------------------
    // USER PROFILES & ROLES
    // ------------------------------------------------------------------------
    match /users/{userId} {
      // User profiles contain contact details; restrict listing to their owner and trusted admins.
      allow read: if isSignedIn() && (
        request.auth.uid == userId ||
        isPlatformOwner() ||
        (hasUserDoc() && isCenterAdmin() &&
         resource.data.orgId != null && getUserOrgId() == resource.data.orgId)
      );

      // Self-registration is restricted to the owner profile of an organization the caller owns.
      // Other roles must be provisioned by an existing center admin or platform owner.
      allow create: if isSignedIn() && (
        (request.auth.uid == userId &&
         request.resource.data.uid == request.auth.uid &&
         request.resource.data.role == 'CENTER_ADMIN' &&
         request.resource.data.orgId is string &&
         ownsOrganization(request.resource.data.orgId)) ||
        isPlatformOwner() ||
        (isCenterAdmin() && hasUserDoc() &&
         request.resource.data.orgId == getUserOrgId() &&
         request.resource.data.role in ['CENTER_ADMIN', 'STAFF', 'TEACHER', 'STUDENT', 'PARENT'])
      );

      // Updates: Users can update their own non-sensitive profile (name, phone, avatar).
      // Role & OrgId changes require Platform Owner or Center Admin of that org.
      allow update: if isSignedIn() && (
        isPlatformOwner() ||
        (request.auth.uid == userId && 
         request.resource.data.role == resource.data.role && 
         (request.resource.data.orgId == resource.data.orgId ||
          (request.resource.data.role == 'CENTER_ADMIN' &&
           ownsOrganization(request.resource.data.orgId))) &&
         (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid) &&
         (!('uid' in resource.data) || request.resource.data.uid == resource.data.uid)) ||
        (isCenterAdmin() && hasUserDoc() &&
         resource.data.orgId == getUserOrgId() &&
         request.resource.data.orgId == resource.data.orgId &&
         request.resource.data.role in ['CENTER_ADMIN', 'STAFF', 'TEACHER', 'STUDENT', 'PARENT'])
      );

      // Only Platform Owner can permanently delete user records
      allow delete: if isPlatformOwner();
    }

    // ------------------------------------------------------------------------
    // ORGANIZATIONS (TUITION & COACHING CENTERS)
    // ------------------------------------------------------------------------
    match /organizations/{orgId} {
      // Center contact details are visible only to its members, owner, matching account, or platform owner.
      allow read: if isSignedIn() && (
        isPlatformOwner() ||
        isTenantMember(orgId) ||
        resource.data.ownerUid == request.auth.uid ||
        (request.auth.token.email != null && resource.data.email == request.auth.token.email)
      );

      // Self-service onboarding may create only a new organization owned by the caller.
      allow create: if isSignedIn() &&
        request.resource.data.id == orgId &&
        request.resource.data.ownerUid == request.auth.uid;

      // Only Center Admin of that organization or Platform Owner can update center profile & settings
      allow update: if isTenantMember(orgId) &&
        (isCenterAdmin() || isPlatformOwner()) &&
        ((!('ownerUid' in resource.data) && !('ownerUid' in request.resource.data)) ||
          request.resource.data.ownerUid == resource.data.ownerUid) &&
        request.resource.data.id == resource.data.id;

      // Only Platform Owner can delete an entire organization
      allow delete: if isPlatformOwner();
    }

    // ------------------------------------------------------------------------
    // OUTBOUND MESSAGES (G3) — append-only delivery queue
    // ------------------------------------------------------------------------
    match /outboundMessages/{msgId} {
      // Center members queue messages for their own org only
      allow create: if isSignedIn() && hasUserDoc() &&
        isTenantMember(request.resource.data.orgId);

      // Members read their org's queue; platform owner reads everything
      allow read: if isSignedIn() && hasUserDoc() &&
        (isPlatformOwner() || isTenantMember(resource.data.orgId));

      // Status transitions (e.g. server marking sent/failed)
      allow update: if isSignedIn() && hasUserDoc() &&
        isTenantMember(resource.data.orgId) &&
        request.resource.data.orgId == resource.data.orgId;

      // Append-only audit trail; retention cleanup runs server-side
      allow delete: if false;
    }

    // ------------------------------------------------------------------------
    // PAYMENT LINKS (G5) — Razorpay link requests & reconciliation
    // ------------------------------------------------------------------------
    match /paymentLinks/{linkId} {
      // Center members queue link requests for their own invoices, and cloud
      // store SKU purchases (notes.sku) carry the same append-only queue.
      allow create: if isSignedIn() && hasUserDoc() &&
        isTenantMember(request.resource.data.orgId) &&
        (request.resource.data.invoiceId is string || request.resource.data.notes.sku is string);

      // Members read their org's links; platform owner reads everything
      allow read: if isSignedIn() && hasUserDoc() &&
        (isPlatformOwner() || isTenantMember(resource.data.orgId));

      // Status transitions + server fulfilment of the link URL
      allow update: if isSignedIn() && hasUserDoc() &&
        isTenantMember(resource.data.orgId) &&
        request.resource.data.orgId == resource.data.orgId;

      allow delete: if false;
    }

    // ------------------------------------------------------------------------
    // WEBHOOK LOG (G5) — server-only event journal for gateway callbacks
    // ------------------------------------------------------------------------
    match /webhookLog/{eventId} {
      allow read: if isSignedIn() && hasUserDoc() && isPlatformOwner();
      // Only Cloud Functions (admin SDK) write here.
      allow write: if false;
    }

    // ------------------------------------------------------------------------
    // STUDENTS COLLECTION
    // ------------------------------------------------------------------------
    match /students/{studentId} {
      // Read: Tenant members can read students in their own center
      allow read: if isSignedIn() && isTenantMember(resource.data.orgId);

      // Create: Center Admin or Staff can admit new students into their org
      allow create: if isSignedIn() && 
        isCenterStaffOrAdmin(request.resource.data.orgId) &&
        request.resource.data.orgId != null;

      // Update: Center Admin or Staff can update student records in their org.
      // Faculty may only change `batchIds` (enrolling/unenrolling) — every other
      // field stays put. Per-batch ownership can't be checked here (rules cannot
      // loop over an array), but a teacher can already update any org batch
      // document, so this grants no new read or write reach: it just lets the
      // `student.batchIds` mirror be kept honest when a roster changes.
      allow update: if isSignedIn() && 
        request.resource.data.orgId == resource.data.orgId &&
        (
          isCenterStaffOrAdmin(resource.data.orgId)
          ||
          (isTeacher() && isTenantMember(resource.data.orgId) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['batchIds']))
        );

      // Delete: Only Center Admin or Platform Owner can delete student records
      allow delete: if isSignedIn() && 
        isTenantMember(resource.data.orgId) && 
        (isCenterAdmin() || isPlatformOwner());
    }

    // ------------------------------------------------------------------------
    // BATCHES COLLECTION
    // ------------------------------------------------------------------------
    match /batches/{batchId} {
      allow read: if isSignedIn() && isTenantMember(resource.data.orgId);

      allow create: if isSignedIn() && 
        isCenterStaffOrAdmin(request.resource.data.orgId);

      allow update: if isSignedIn() && 
        isTenantMember(resource.data.orgId) && 
        (isCenterAdmin() || isStaff() || isTeacher() || isPlatformOwner()) &&
        request.resource.data.orgId == resource.data.orgId;

      allow delete: if isSignedIn() && 
        isTenantMember(resource.data.orgId) && 
        (isCenterAdmin() || isPlatformOwner());
    }

    // ------------------------------------------------------------------------
    // TEACHERS COLLECTION
    // ------------------------------------------------------------------------
    match /teachers/{teacherId} {
      allow read: if isSignedIn() && isTenantMember(resource.data.orgId);

      allow create, update, delete: if isSignedIn() && 
        isTenantMember(request.resource.data.orgId != null ? request.resource.data.orgId : resource.data.orgId) && 
        (isCenterAdmin() || isPlatformOwner());
    }

    // ------------------------------------------------------------------------
    // INVOICES & FEE PAYMENTS
    // ------------------------------------------------------------------------
    match /invoices/{invoiceId} {
      allow read: if isSignedIn() && isTenantMember(resource.data.orgId);

      allow create: if isSignedIn() && 
        isCenterStaffOrAdmin(request.resource.data.orgId);

      allow update: if isSignedIn() && 
        isTenantMember(resource.data.orgId) &&
        isCenterStaffOrAdmin(resource.data.orgId) &&
        request.resource.data.orgId == resource.data.orgId;

      allow delete: if isSignedIn() && 
        isTenantMember(resource.data.orgId) && 
        (isCenterAdmin() || isPlatformOwner());
    }

    // ------------------------------------------------------------------------
    // PENDING PAYER-REPORTED UPI TRANSFERS
    // ------------------------------------------------------------------------
    function isLinkedToStudent(studentId) {
      let studentPath = /databases/$(database)/documents/students/$(studentId);
      return exists(studentPath) && (
        get(studentPath).data.userId == request.auth.uid ||
        get(studentPath).data.guardian.parentUserId == request.auth.uid ||
        (hasUserDoc() &&
         getUserDoc().linkedStudentIds is list &&
         getUserDoc().linkedStudentIds.hasAny([studentId]))
      );
    }

    function isValidPaymentSubmission(data) {
      return data.keys().hasOnly([
          'id', 'orgId', 'invoiceId', 'studentId', 'amount', 'paymentMethod',
          'transactionRef', 'upiApp', 'submittedBy', 'submittedByName',
          'submittedAt', 'status', 'reviewedBy', 'reviewedAt', 'rejectionReason'
        ]) &&
        data.keys().hasAll([
          'id', 'orgId', 'invoiceId', 'studentId', 'amount', 'paymentMethod',
          'transactionRef', 'submittedBy', 'submittedByName', 'submittedAt', 'status'
        ]) &&
        data.id is string && data.id.size() <= 100 &&
        data.orgId is string && data.orgId.size() <= 100 &&
        data.invoiceId is string && data.invoiceId.size() <= 150 &&
        data.studentId is string && data.studentId.size() <= 150 &&
        data.amount is number && data.amount > 0 && data.amount <= 10000000 &&
        data.paymentMethod == 'UPI' &&
        data.transactionRef is string && data.transactionRef.matches('^[0-9]{12}$') &&
        data.submittedBy is string && data.submittedBy.size() <= 128 &&
        data.submittedByName is string && data.submittedByName.size() > 0 && data.submittedByName.size() <= 100 &&
        data.submittedAt is string && data.submittedAt.size() <= 40 &&
        data.status in ['pending_verification', 'verified', 'rejected'] &&
        (!('upiApp' in data) || data.upiApp in ['gpay', 'phonepe', 'paytm', 'bhim']) &&
        (!('reviewedBy' in data) || (data.reviewedBy is string && data.reviewedBy.size() <= 128)) &&
        (!('reviewedAt' in data) || (data.reviewedAt is string && data.reviewedAt.size() <= 40)) &&
        (!('rejectionReason' in data) || (data.rejectionReason is string && data.rejectionReason.size() <= 200));
    }

    // F8 — the PTM window an admin opens. Strict enough that a malformed event
    // can't carry bad times or an empty teacher list into the slot cutter.
    function isValidPtmEvent(data) {
      return data.keys().hasOnly([
        'id', 'orgId', 'branchId', 'title', 'date', 'startTime', 'endTime',
        'slotMinutes', 'teacherIds', 'notes', 'createdBy', 'createdAt'
      ]) &&
        data.id is string && data.id.size() <= 120 &&
        data.orgId is string &&
        data.branchId is string &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 120 &&
        data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.startTime is string &&
        data.endTime is string &&
        data.slotMinutes is int && data.slotMinutes >= 10 && data.slotMinutes <= 60 &&
        data.teacherIds is list && data.teacherIds.size() >= 1 && data.teacherIds.size() <= 50 &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 500)) &&
        data.createdBy is string &&
        data.createdAt is string;
    }

    // F8 — one row of the booking grid. `booked*` fields may be absent on a
    // fresh available slot and are explicitly NULL once a booking is released,
    // so both states stay inside the field-lock's key set.
    function isValidPtmSlot(data) {
      return data.keys().hasOnly([
        'id', 'orgId', 'branchId', 'eventId', 'teacherId', 'startsAt', 'endsAt',
        'status', 'bookedByUserId', 'bookedStudentId', 'bookedForName', 'bookedAt'
      ]) &&
        data.id is string && data.id.size() <= 160 &&
        data.orgId is string &&
        data.branchId is string &&
        data.eventId is string &&
        data.teacherId is string && data.teacherId.size() <= 120 &&
        data.startsAt is string &&
        data.endsAt is string &&
        data.status in ['available', 'booked', 'cancelled'] &&
        (!('bookedByUserId' in data) || data.bookedByUserId is string || data.bookedByUserId == null) &&
        (!('bookedStudentId' in data) || data.bookedStudentId is string || data.bookedStudentId == null) &&
        (!('bookedForName' in data) || data.bookedForName is string || data.bookedForName == null) &&
        (!('bookedAt' in data) || data.bookedAt is string || data.bookedAt == null);
    }

    match /paymentSubmissions/{submissionId} {
      allow read: if isSignedIn() && (
        (resource.data.submittedBy == request.auth.uid) ||
        isCenterStaffOrAdmin(resource.data.orgId)
      );

      allow create: if isSignedIn() &&
        isValidPaymentSubmission(request.resource.data) &&
        request.resource.data.id == submissionId &&
        request.resource.data.submittedBy == request.auth.uid &&
        request.resource.data.status == 'pending_verification' &&
        request.resource.data.paymentMethod == 'UPI' &&
        (isStudent() || isParent()) &&
        isTenantMember(request.resource.data.orgId) &&
        isLinkedToStudent(request.resource.data.studentId) &&
        exists(/databases/$(database)/documents/invoices/$(request.resource.data.invoiceId)) &&
        get(/databases/$(database)/documents/invoices/$(request.resource.data.invoiceId)).data.orgId == request.resource.data.orgId &&
        get(/databases/$(database)/documents/invoices/$(request.resource.data.invoiceId)).data.studentId == request.resource.data.studentId &&
        request.resource.data.amount <=
          get(/databases/$(database)/documents/invoices/$(request.resource.data.invoiceId)).data.netAmount -
          get(/databases/$(database)/documents/invoices/$(request.resource.data.invoiceId)).data.paidAmount;

      allow update: if isSignedIn() &&
        isCenterStaffOrAdmin(resource.data.orgId) &&
        isValidPaymentSubmission(request.resource.data) &&
        request.resource.data.orgId == resource.data.orgId &&
        request.resource.data.invoiceId == resource.data.invoiceId &&
        request.resource.data.studentId == resource.data.studentId &&
        request.resource.data.amount == resource.data.amount &&
        request.resource.data.transactionRef == resource.data.transactionRef &&
        request.resource.data.submittedBy == resource.data.submittedBy &&
        resource.data.status == 'pending_verification' &&
        request.resource.data.status in ['verified', 'rejected'] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'reviewedBy', 'reviewedAt', 'rejectionReason'
        ]);

      allow delete: if isSignedIn() && isCenterStaffOrAdmin(resource.data.orgId);
    }

    // ------------------------------------------------------------------------
    // ATTENDANCE RECORDS
    // ------------------------------------------------------------------------
    match /attendance/{attendanceId} {
      allow read: if isSignedIn() && isTenantMember(resource.data.orgId);

      allow create, update: if isSignedIn() && 
        (isCenterStaffOrAdmin(request.resource.data.orgId) || isTeacher()) &&
        isTenantMember(request.resource.data.orgId);

      allow delete: if isSignedIn() && 
        isTenantMember(resource.data.orgId) && 
        (isCenterAdmin() || isPlatformOwner());
    }

    // ------------------------------------------------------------------------
    // EXAMS & TEST SCHEDULES
    // ------------------------------------------------------------------------
    match /exams/{examId} {
      allow read: if isSignedIn() && isTenantMember(resource.data.orgId);

      allow create, update, delete: if isSignedIn() && 
        isCenterInstructorOrAdmin(request.resource.data.orgId) &&
        isTenantMember(request.resource.data.orgId);
    }

    // ------------------------------------------------------------------------
    // EXAM RESULTS & MARKS
    // ------------------------------------------------------------------------
    match /examResults/{resultId} {
      // Only tenant members can read exam results. Removed the orgId==null bypass
      // that allowed orphaned/unseeded results to leak across tenants.
      allow read: if isSignedIn() && (
        isTenantMember(resource.data.orgId)
      );

      // Only teachers and center admins within tenant can create, update, delete graded results
      allow create, update, delete: if isSignedIn() && (
        isCenterInstructorOrAdmin(request.resource.data.orgId != null ? request.resource.data.orgId : resource.data.orgId)
      );
    }

    // ------------------------------------------------------------------------
    // ANNOUNCEMENTS
    // ------------------------------------------------------------------------
    match /announcements/{announcementId} {
      allow read: if isSignedIn() && isTenantMember(resource.data.orgId);

      allow create, update, delete: if isSignedIn() && 
        isCenterStaffOrAdmin(request.resource.data.orgId);
    }

    // ------------------------------------------------------------------------
    // ASSIGNMENTS & HOMEWORK
    // ------------------------------------------------------------------------
    match /assignments/{assignId} {
      allow read: if isSignedIn() && isTenantMember(resource.data.orgId);

      // Teachers and Admins can create/delete; Students can update submissions array
      allow create, delete: if isSignedIn() && 
        isCenterInstructorOrAdmin(request.resource.data.orgId);

      allow update: if isSignedIn() && 
        isTenantMember(resource.data.orgId);
    }

    // ------------------------------------------------------------------------
    // STUDY MATERIALS & NOTES
    // ------------------------------------------------------------------------
    match /studyMaterials/{matId} {
      allow read: if isSignedIn() && isTenantMember(resource.data.orgId);

      allow create, update, delete: if isSignedIn() && 
        isCenterInstructorOrAdmin(request.resource.data.orgId);
    }

    // ------------------------------------------------------------------------
    // CHAT CHANNELS & MESSAGES (VIDYACHAT)
    // ------------------------------------------------------------------------
    match /chatChannels/{channelId} {
      allow read: if isSignedIn() && isTenantMember(resource.data.orgId);
      // Only staff may create or remove channels.
      allow create: if isSignedIn() &&
        isTenantMember(request.resource.data.orgId) &&
        isCenterInstructorOrAdmin(request.resource.data.orgId);
      allow delete: if isSignedIn() &&
        isTenantMember(resource.data.orgId) &&
        isCenterInstructorOrAdmin(resource.data.orgId);
      // Any tenant member may bump the last-message preview when sending, but
      // nobody may rewrite allowedRoles/isPrivate after the fact — otherwise a
      // student could add themselves to the faculty lounge.
      allow update: if isSignedIn() &&
        isTenantMember(resource.data.orgId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastMessage', 'lastMessageTime', 'lastMessageMs']);
    }

    match /chatMessages/{messageId} {
      allow read: if isSignedIn() && isTenantMember(resource.data.orgId);
      // Require senderId to match authenticated user to prevent message spoofing
      allow create: if isSignedIn() &&
        isTenantMember(request.resource.data.orgId) &&
        request.resource.data.senderId == request.auth.uid;
      // Editing or deleting a message: only its author, an org admin, or the
      // platform owner.
      allow update, delete: if isSignedIn() && isTenantMember(resource.data.orgId) &&
        (request.auth.uid == resource.data.senderId || isCenterAdmin() || isPlatformOwner());
      // Reacting mutates ONLY the reactions map, so any tenant member may toggle
      // reactions on any message without thereby gaining the right to edit it.
      allow update: if isSignedIn() &&
        isTenantMember(resource.data.orgId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']);
    }

    // ------------------------------------------------------------------------
    // AUDIT LOG (F1) — append-only, staff/admin visibility only
    // ------------------------------------------------------------------------
    match /auditLogs/{entryId} {
      // Only center staff/admins (and the platform owner) may read the change
      // history. Teachers, students and parents never see audit frames.
      allow read: if isSignedIn() &&
        isCenterStaffOrAdmin(resource.data.orgId);

      // The app writes audit frames as the signed-in actor; spoofing another
      // user's attribution is rejected.
      allow create: if isSignedIn() &&
        isCenterStaffOrAdmin(request.resource.data.orgId) &&
        request.resource.data.actorUserId == request.auth.uid;

      // Immutable history — an audit entry can never be edited or deleted.
      allow update, delete: if false;
    }

    // ------------------------------------------------------------------------
    // INQUIRIES / LEADS (F2) — admission pipeline
    // ------------------------------------------------------------------------
    match /inquiries/{inquiryId} {
      // Any tenant member may view the funnel (front desk, faculty, owner).
      allow read: if isSignedIn() &&
        isTenantMember(resource.data.orgId);

      // Only staff/admins maintain leads: create, move statuses, convert,
      // append notes, or remove a stale enquiry.
      allow create: if isSignedIn() &&
        isCenterStaffOrAdmin(request.resource.data.orgId);

      allow update, delete: if isSignedIn() &&
        isCenterStaffOrAdmin(resource.data.orgId);
    }

    // ------------------------------------------------------------------------
    // LEAVE REQUESTS (F3) — absence asks filed by families/faculty, reviewed
    // ------------------------------------------------------------------------
    match /leaveRequests/{leaveId} {
      function leaveStudentDoc(sid) {
        return get(/databases/$(database)/documents/students/$(sid)).data;
      }

      function leaveTeacherDoc(tid) {
        return get(/databases/$(database)/documents/teachers/$(tid)).data;
      }

      // Any tenant member may view the leave board (front desk, faculty, families).
      allow read: if isSignedIn() &&
        isTenantMember(resource.data.orgId);

      // Filing. Staff/admin may file on anyone's behalf inside their centre —
      // and because that branch short-circuits first, it never pays for the
      // get() joins below (get() results are cached per evaluation anyway).
      // Everyone else may only file for a record they actually own: the joins
      // verify the claimed student/teacher belongs to this org AND links to
      // this exact auth uid (student self, parent link, or faculty userId).
      // A request can only be born 'pending' — approvals arrive via update.
      allow create: if isSignedIn() &&
        isTenantMember(request.resource.data.orgId) &&
        request.resource.data.status == 'pending' &&
        request.resource.data.requestedByUserId == request.auth.uid &&
        (
          isCenterStaffOrAdmin(request.resource.data.orgId)
          ||
          (
            request.resource.data.requesterType == 'student' &&
            request.resource.data.studentId is string &&
            leaveStudentDoc(request.resource.data.studentId).orgId == request.resource.data.orgId &&
            (
              ('userId' in leaveStudentDoc(request.resource.data.studentId) &&
               leaveStudentDoc(request.resource.data.studentId).userId == request.auth.uid)
              ||
              ('guardian' in leaveStudentDoc(request.resource.data.studentId) &&
               'parentUserId' in leaveStudentDoc(request.resource.data.studentId).guardian &&
               leaveStudentDoc(request.resource.data.studentId).guardian.parentUserId == request.auth.uid)
            )
          )
          ||
          (
            request.resource.data.requesterType == 'teacher' &&
            request.resource.data.teacherId is string &&
            leaveTeacherDoc(request.resource.data.teacherId).orgId == request.resource.data.orgId &&
            'userId' in leaveTeacherDoc(request.resource.data.teacherId) &&
            leaveTeacherDoc(request.resource.data.teacherId).userId == request.auth.uid
          )
        );

      // Decisions only travel one way: from pending to approved/rejected.
      // The field lists are split so neither side can cross into the other —
      // a filer can never flip status, and a reviewer can never rewrite the
      // dates/reason they are deciding on. Identity, org and attribution
      // fields are outside both lists, so they are immutable either way.
      //
      // NOTE (rules honesty): faculty review is allowed for any pending leave
      // of their own centre. Scoping a teacher to their own batches cannot be
      // expressed here — a Teacher doc is not keyed by auth uid, so rules
      // cannot join reviewer → assigned batches; product code enforces it
      // (`scopeLeaveRequestsForTeacher`), exactly like batch roster scoping.
      allow update: if isSignedIn() &&
        isTenantMember(resource.data.orgId) &&
        resource.data.status == 'pending' &&
        (
          // (a) the filer refines their own request while it waits — status untouched
          (
            request.resource.data.requestedByUserId == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['startDate', 'endDate', 'reason', 'category', 'updatedAt'])
          )
          ||
          // (b) a reviewer decides: front desk/owner always, faculty for their
          //     batches (product-side). The reviewer must be the signed-in actor.
          (
            (isCenterStaffOrAdmin(resource.data.orgId) || isTeacher()) &&
            request.resource.data.status in ['approved', 'rejected'] &&
            request.resource.data.reviewedByUserId == request.auth.uid &&
            request.resource.data.reviewedAt is string &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'reviewedByUserId', 'reviewedByName', 'reviewedAt', 'reviewNote', 'updatedAt'])
          )
        );

      // Removal stays at the front desk — families cannot withdraw through
      // delete (they refine or live with a pending request instead).
      allow delete: if isSignedIn() &&
        isCenterStaffOrAdmin(resource.data.orgId);
    }

    // ------------------------------------------------------------------------
    // FACULTY ATTENDANCE (F4) — self check-in/out rows, one per teacher per day
    // ------------------------------------------------------------------------
    match /teacherAttendance/{attId} {
      function attTeacherDoc(tid) {
        return get(/databases/$(database)/documents/teachers/$(tid)).data;
      }

      // Any tenant member may view the day grid (families never need it, but
      // the extra read is harmless and keeps the query rules simple).
      allow read: if isSignedIn() &&
        isTenantMember(resource.data.orgId);

      // Stamping. The actor must always be the signed-in user, the row must
      // be born well-formed, and a faculty member may only ever create their
      // OWN row — the join proves teachers/{teacherId} belongs to this org
      // AND links to this exact auth uid. Staff/admin short-circuit first, so
      // desk writes never pay for the get() joins below.
      allow create: if isSignedIn() &&
        isTenantMember(request.resource.data.orgId) &&
        request.resource.data.markedByUserId == request.auth.uid &&
        request.resource.data.teacherId is string &&
        request.resource.data.date is string &&
        request.resource.data.status in ['present', 'absent', 'half_day', 'on_leave'] &&
        (
          isCenterStaffOrAdmin(request.resource.data.orgId)
          ||
          (
            isTeacher() &&
            attTeacherDoc(request.resource.data.teacherId).orgId == request.resource.data.orgId &&
            attTeacherDoc(request.resource.data.teacherId).userId == request.auth.uid
          )
        );

      // Corrections. The identity pins + field allowlist run FIRST for every
      // actor — so even a desk session cannot re-point a row at another org
      // (tenant pollution) or smuggle in unknown fields. Then the role gate:
      // desk sessions may rewrite any row inside their centre; faculty may
      // only touch their own row (teacher doc join), with `markedByUserId`
      // either staying put or becoming their own uid — never somebody else's.
      // The get() joins below only evaluate for non-desk actors (`||` short
      // circuits), and only after `isTeacher()` passes (`&&` short circuits).
      allow update: if isSignedIn() &&
        isTenantMember(resource.data.orgId) &&
        request.resource.data.orgId == resource.data.orgId &&
        request.resource.data.branchId == resource.data.branchId &&
        request.resource.data.teacherId == resource.data.teacherId &&
        request.resource.data.date == resource.data.date &&
        request.resource.data.status in ['present', 'absent', 'half_day', 'on_leave'] &&
        request.resource.data.markedByUserId is string &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'checkIn', 'checkOut', 'remarks', 'markedAt', 'markedByUserId']) &&
        (
          isCenterStaffOrAdmin(resource.data.orgId)
          ||
          (
            isTeacher() &&
            attTeacherDoc(resource.data.teacherId).orgId == resource.data.orgId &&
            attTeacherDoc(resource.data.teacherId).userId == request.auth.uid &&
            (
              request.resource.data.markedByUserId == request.auth.uid ||
              request.resource.data.markedByUserId == resource.data.markedByUserId
            )
          )
        );

      // Clearing a cell is a desk action only — a teacher cannot erase the
      // record of their own (mis)behaviour through delete.
      allow delete: if isSignedIn() &&
        isCenterStaffOrAdmin(resource.data.orgId);
    }

    // ------------------------------------------------------------------------
    // SALARY SLIPS (F4) — desk composes & pays; every tenant member reads
    // ------------------------------------------------------------------------
    match /salarySlips/{slipId} {
      // Read = tenant member. The My Day card scopes faculty to their own
      // slips in the product; rules stay org-wide like the leave board.
      allow read: if isSignedIn() &&
        isTenantMember(resource.data.orgId);

      // Born at the desk, well-formed. Teachers/students never write money.
      allow create: if isSignedIn() &&
        isCenterStaffOrAdmin(request.resource.data.orgId) &&
        request.resource.data.status in ['draft', 'issued', 'paid'] &&
        request.resource.data.teacherId is string &&
        request.resource.data.monthYear is string &&
        request.resource.data.netAmount is number;

      // Updates follow the app's exact lifecycle: draft → issued (status +
      // issuedAt) and issued → paid (status + payment fields), with the
      // tenant/teacher/month identity pinned immutable. Amounts are NEVER
      // editable in place — a correction means delete + recompose, so a paid
      // figure can't be quietly rewritten after the fact.
      allow update: if isSignedIn() &&
        isCenterStaffOrAdmin(resource.data.orgId) &&
        request.resource.data.orgId == resource.data.orgId &&
        request.resource.data.branchId == resource.data.branchId &&
        request.resource.data.teacherId == resource.data.teacherId &&
        request.resource.data.monthYear == resource.data.monthYear &&
        request.resource.data.status in ['draft', 'issued', 'paid'] &&
        request.resource.data.netAmount == resource.data.netAmount &&
        request.resource.data.basic == resource.data.basic &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'issuedAt', 'paidAmount', 'paymentMethod', 'paidAt', 'paidBy']);

      allow delete: if isSignedIn() &&
        isCenterStaffOrAdmin(resource.data.orgId);
    }

    // ------------------------------------------------------------------------
    // EXPENSES (F5) — money-out ledger powering the Profit & Loss tab
    // ------------------------------------------------------------------------
    match /expenses/{expenseId} {
      // Any tenant member may view the ledger (owner, front desk, faculty).
      allow read: if isSignedIn() &&
        isTenantMember(resource.data.orgId);

      // Only staff/admins record money out. The amount and category are
      // validated at birth so a malformed row can never skew the P&L, and the
      // recorder is pinned to the caller.
      allow create: if isSignedIn() &&
        isCenterStaffOrAdmin(request.resource.data.orgId) &&
        request.resource.data.amount is number &&
        request.resource.data.amount > 0 &&
        request.resource.data.amount <= 10000000 &&
        request.resource.data.title is string &&
        request.resource.data.expenseDate is string &&
        request.resource.data.category in [
          'rent', 'salaries', 'electricity', 'internet',
          'marketing', 'maintenance', 'printing', 'misc'
        ] &&
        request.resource.data.recordedByUserId == request.auth.uid;

      // Desk corrections may fix a typo, re-categorise, or move the date — but
      // the org and the person who recorded it stay frozen, and the amount
      // stays inside sane bounds.
      allow update: if isSignedIn() &&
        isCenterStaffOrAdmin(resource.data.orgId) &&
        request.resource.data.orgId == resource.data.orgId &&
        request.resource.data.recordedByUserId == resource.data.recordedByUserId &&
        request.resource.data.amount is number &&
        request.resource.data.amount > 0 &&
        request.resource.data.amount <= 10000000 &&
        request.resource.data.title is string &&
        request.resource.data.expenseDate is string &&
        request.resource.data.category in [
          'rent', 'salaries', 'electricity', 'internet',
          'marketing', 'maintenance', 'printing', 'misc'
        ];

      allow delete: if isSignedIn() &&
        isCenterStaffOrAdmin(resource.data.orgId);
    }

    // ------------------------------------------------------------------------
    // TIMETABLE (F6) — weekly class schedule + optional live class link
    // ------------------------------------------------------------------------
    match /timetableSlots/{slotId} {
      // Every tenant member reads the schedule — students and parents need it
      // to see the "Join Class" button.
      allow read: if isSignedIn() &&
        isTenantMember(resource.data.orgId);

      // The desk owns the schedule. A slot must be well-formed (a real weekday,
      // a batch, clock strings, and any link short enough to be an address).
      allow create: if isSignedIn() &&
        isCenterStaffOrAdmin(request.resource.data.orgId) &&
        request.resource.data.dayOfWeek in [
          'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'
        ] &&
        request.resource.data.batchId is string &&
        request.resource.data.startTime is string &&
        request.resource.data.endTime is string &&
        request.resource.data.get('meetUrl', '') is string &&
        request.resource.data.get('meetUrl', '').size() <= 512;

      // Edits keep the slot inside its centre; the same well-formedness applies.
      allow update: if isSignedIn() &&
        isCenterStaffOrAdmin(resource.data.orgId) &&
        request.resource.data.orgId == resource.data.orgId &&
        request.resource.data.dayOfWeek in [
          'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'
        ] &&
        request.resource.data.batchId is string &&
        request.resource.data.startTime is string &&
        request.resource.data.endTime is string &&
        request.resource.data.get('meetUrl', '') is string &&
        request.resource.data.get('meetUrl', '').size() <= 512;

      allow delete: if isSignedIn() &&
        isCenterStaffOrAdmin(resource.data.orgId);
    }

    // ------------------------------------------------------------------------
    // SYLLABUS COVERAGE (F7) — chapter-by-chapter checklist per batch
    // ------------------------------------------------------------------------
    match /syllabusTopics/{topicId} {
      // Every tenant member reads coverage — students & parents render their
      // read-only progress bar from exactly these rows.
      allow read: if isSignedIn() &&
        isTenantMember(resource.data.orgId);

      // Only instructors and centre admins seed or tick the syllabus. Students
      // and the front desk (staff) may never write. A topic must be well-formed
      // so a bad status can't skew the coverage percentage.
      allow create: if isSignedIn() &&
        isCenterInstructorOrAdmin(request.resource.data.orgId) &&
        request.resource.data.status in ['not_started', 'in_progress', 'completed'] &&
        request.resource.data.batchId is string &&
        request.resource.data.subject is string &&
        request.resource.data.classGrade is string &&
        request.resource.data.chapter is string &&
        request.resource.data.title is string &&
        request.resource.data.sequence is number;

      // Edits keep the topic inside its centre; the same well-formedness applies.
      allow update: if isSignedIn() &&
        isCenterInstructorOrAdmin(resource.data.orgId) &&
        request.resource.data.orgId == resource.data.orgId &&
        request.resource.data.status in ['not_started', 'in_progress', 'completed'] &&
        request.resource.data.batchId is string &&
        request.resource.data.subject is string &&
        request.resource.data.classGrade is string &&
        request.resource.data.chapter is string &&
        request.resource.data.title is string &&
        request.resource.data.sequence is number;

      allow delete: if isSignedIn() &&
        isCenterInstructorOrAdmin(resource.data.orgId);
    }

    // ------------------------------------------------------------------------
    // PTM SCHEDULER (F8) — parent–teacher meeting windows + slot grid
    // ------------------------------------------------------------------------
    match /ptmEvents/{eventId} {
      // Every tenant member reads the windows — parents need the grid headers,
      // faculty need the diary titles. Only the desk writes.
      allow read: if isSignedIn() &&
        isTenantMember(resource.data.orgId);

      allow create: if isSignedIn() &&
        isCenterStaffOrAdmin(request.resource.data.orgId) &&
        isValidPtmEvent(request.resource.data) &&
        request.resource.data.id == eventId &&
        request.resource.data.createdBy == request.auth.uid;

      // Edits keep the event inside its centre; well-formedness re-applies and
      // the creator stamp never moves (desk corrections only).
      allow update: if isSignedIn() &&
        isCenterStaffOrAdmin(resource.data.orgId) &&
        isValidPtmEvent(request.resource.data) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.orgId == resource.data.orgId &&
        request.resource.data.createdBy == resource.data.createdBy;

      allow delete: if isSignedIn() &&
        isCenterStaffOrAdmin(resource.data.orgId);
    }

    match /ptmSlots/{slotId} {
      // The teacher join backing the "teacher reads own" rule: a faculty
      // session may only see slots whose teacherId points at their own record.
      function slotIsMine(teacherId) {
        return exists(/databases/$(database)/documents/teachers/$(teacherId)) &&
          get(/databases/$(database)/documents/teachers/$(teacherId)).data.userId == request.auth.uid;
      }

      // Non-faculty tenant members read the whole org grid (desk runs events,
      // families pick times). Faculty pass only when the doc pins teacherId to
      // their own record — or they were the booker.
      allow read: if isSignedIn() &&
        isTenantMember(resource.data.orgId) &&
        (
          !isTeacher() ||
          slotIsMine(resource.data.teacherId) ||
          resource.data.bookedByUserId == request.auth.uid
        );

      // Slot documents are born of grid generation (staff/admin only) and must
      // cite an event that exists inside the same centre.
      allow create: if isSignedIn() &&
        isCenterStaffOrAdmin(request.resource.data.orgId) &&
        isValidPtmSlot(request.resource.data) &&
        request.resource.data.id == slotId &&
        exists(/databases/$(database)/documents/ptmEvents/$(request.resource.data.eventId)) &&
        get(/databases/$(database)/documents/ptmEvents/$(request.resource.data.eventId)).data.orgId == request.resource.data.orgId;

      // The booking field-lock (mirrors `paymentSubmissions`): every actor must
      // keep the identity pins (id/org/event/teacher/times) and ship a
      // whole-well-formed slot, touching nothing outside status + the four
      // `booked*` keys. A family may then either CLAIM a free slot — status
      // must be 'available' server-side right now, so a racing second booker
      // re-reads 'booked' and is denied (double-book impossible) — or RELEASE
      // their own booking back to 'available'. The desk may override any cell
      // (reassign or retire) but stays inside the same lock.
      allow update: if isSignedIn() &&
        isTenantMember(resource.data.orgId) &&
        isValidPtmSlot(request.resource.data) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.orgId == resource.data.orgId &&
        request.resource.data.branchId == resource.data.branchId &&
        request.resource.data.eventId == resource.data.eventId &&
        request.resource.data.teacherId == resource.data.teacherId &&
        request.resource.data.startsAt == resource.data.startsAt &&
        request.resource.data.endsAt == resource.data.endsAt &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'bookedByUserId', 'bookedStudentId', 'bookedForName', 'bookedAt'
        ]) &&
        (
          isCenterStaffOrAdmin(resource.data.orgId)
          ||
          (
            (isStudent() || isParent()) &&
            (
              // claim a free slot for a child you are linked to
              (
                resource.data.status == 'available' &&
                request.resource.data.status == 'booked' &&
                request.resource.data.bookedByUserId == request.auth.uid &&
                request.resource.data.bookedStudentId is string &&
                isLinkedToStudent(request.resource.data.bookedStudentId) &&
                request.resource.data.bookedForName is string &&
                request.resource.data.bookedAt is string
              )
              ||
              // release your own booking — the slot is free again
              (
                resource.data.status == 'booked' &&
                resource.data.bookedByUserId == request.auth.uid &&
                request.resource.data.status == 'available' &&
                request.resource.data.bookedByUserId == null &&
                request.resource.data.bookedStudentId == null &&
                request.resource.data.bookedForName == null &&
                request.resource.data.bookedAt == null
              )
            )
          )
        );

      allow delete: if isSignedIn() &&
        isCenterStaffOrAdmin(resource.data.orgId);
    }

    // ------------------------------------------------------------------------
    // ISSUED DOCUMENTS (F9) — append-only register behind ID cards & TCs
    // ------------------------------------------------------------------------
    function isValidIssuedDocument(data) {
      return data.keys().hasOnly([
          'id', 'orgId', 'branchId', 'studentId', 'type', 'tcNo',
          'leavingDate', 'remarks', 'issuedAt', 'issuedByUserId', 'issuedByName'
        ]) &&
        data.keys().hasAll([
          'id', 'orgId', 'branchId', 'studentId', 'type', 'issuedAt',
          'issuedByUserId', 'issuedByName'
        ]) &&
        data.id is string && data.id.size() <= 120 &&
        data.orgId is string && data.orgId.size() <= 100 &&
        data.branchId is string && data.branchId.size() <= 100 &&
        data.studentId is string && data.studentId.size() <= 150 &&
        data.type in ['id_card', 'tc'] &&
        (
          data.type == 'tc'
            ? (data.tcNo is string && data.tcNo.size() <= 60 &&
               data.tcNo.matches('^[A-Z0-9]+/[0-9]{4}/[0-9]{3,}$'))
            : (!('tcNo' in data) || data.tcNo == null)
        ) &&
        (!('leavingDate' in data) || data.leavingDate == null ||
          (data.leavingDate is string && data.leavingDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))) &&
        (!('remarks' in data) || data.remarks == null ||
          (data.remarks is string && data.remarks.size() <= 500)) &&
        data.issuedAt is string &&
        data.issuedByUserId is string && data.issuedByUserId.size() <= 128 &&
        data.issuedByName is string && data.issuedByName.size() <= 120;
    }

    match /issuedDocuments/{documentId} {
      // Every tenant member may read the register, but a student/parent session
      // only sees documents for a learner it is linked to. The app pins the
      // query to `studentId` for those sessions, so the list stays provable.
      allow read: if isSignedIn() &&
        isTenantMember(resource.data.orgId) &&
        (
          !(isStudent() || isParent()) ||
          isLinkedToStudent(resource.data.studentId)
        );

      // Desk-only issuance: staff/admin record the accession and cannot forge
      // the operator. A learner never creates a register row.
      allow create: if isSignedIn() &&
        isCenterStaffOrAdmin(request.resource.data.orgId) &&
        isValidIssuedDocument(request.resource.data) &&
        request.resource.data.id == documentId &&
        request.resource.data.issuedByUserId == request.auth.uid;

      // Append-only: a printed serial and its audit trail can never be edited.
      allow update, delete: if false;
    }

    // ------------------------------------------------------------------------
    // LOCKED CREDENTIALS COLLECTION (STRICTLY DISALLOWED TO PREVENT PLAINTEXT EXPOSURE)
    // ------------------------------------------------------------------------
    match /credentials/{phone} {
      allow read, write: if false;
    }

    // Test connection doc (Authenticated only)
    match /test/{docId} {
      allow read, write: if isSignedIn();
    }

    // Default-deny all unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
