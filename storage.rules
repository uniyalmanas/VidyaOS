rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Study materials & digital library (readable by all, uploadable by authenticated staff)
    match /study-materials/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Homework assignments and student submissions
    match /assignments/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Institute logos and branding assets
    match /logos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // User profile avatars
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Receipts and fee records
    match /receipts/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default: allow authenticated reads and writes
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
