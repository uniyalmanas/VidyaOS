rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidFileSize() {
      return request.resource.size < 15 * 1024 * 1024; // 15MB limit
    }

    function isPermittedContentType() {
      return request.resource.contentType.matches('image/.*') ||
             request.resource.contentType.matches('application/pdf') ||
             request.resource.contentType.matches('application/vnd.*') ||
             request.resource.contentType.matches('application/msword') ||
             request.resource.contentType.matches('text/plain');
    }

    // ------------------------------------------------------------------------
    // TENANT-SCOPED STORAGE: /{orgId}/{category}/{fileName}
    // ------------------------------------------------------------------------
    
    // Study materials & digital library (Authenticated users, scoped per center)
    match /{orgId}/study-materials/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidFileSize() && isPermittedContentType();
      allow delete: if isSignedIn();
    }

    // Homework assignments and student submissions
    match /{orgId}/assignments/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidFileSize() && isPermittedContentType();
      allow delete: if isSignedIn();
    }

    // Institute logos and branding assets
    match /{orgId}/logos/{fileName} {
      allow read: if true; // Public for website and invoices
      allow write: if isSignedIn() && isValidFileSize() && request.resource.contentType.matches('image/.*');
      allow delete: if isSignedIn();
    }

    // User profile avatars
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == userId && isValidFileSize() && request.resource.contentType.matches('image/.*');
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Private Receipts & Fee Invoices (Authenticated staff & parents only)
    match /{orgId}/receipts/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidFileSize() && isPermittedContentType();
      allow delete: if isSignedIn();
    }

    // Legacy fallback paths with auth & size constraints
    match /study-materials/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidFileSize() && isPermittedContentType();
    }

    match /assignments/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidFileSize() && isPermittedContentType();
    }

    match /logos/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && isValidFileSize() && request.resource.contentType.matches('image/.*');
    }

    match /receipts/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidFileSize() && isPermittedContentType();
    }

    // Default deny for unmatched storage paths
    match /{allPaths=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
